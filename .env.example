# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API.
#
# ATENÇÃO: use SOMENTE a chave pública "anon" (ou "publishable").
# NUNCA coloque a chave "service_role" (ou "secret") em variáveis VITE_*:
# tudo que começa com VITE_ é embutido no JavaScript enviado ao navegador.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: nome da imobiliária exibido na tela de login.
# VITE_IMOBILIARIA_NOME=Imobiliária Exemplo
